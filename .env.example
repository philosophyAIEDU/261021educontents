# 이 파일을 복사해서 `.env`라는 이름으로 만들고 값을 채우세요. (.env는 git에 올라가지 않습니다)
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac/Linux:           cp .env.example .env
# 값은 따옴표 없이 적습니다. 이 파일의 내용을 채팅이나 GitHub에 붙여 넣지 마세요.

# [필수] Firebase 콘솔 > 프로젝트 설정 > 일반 > "프로젝트 ID"
FIREBASE_PROJECT_ID=

# [필수] 서비스 계정 키 파일 경로. Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로
# 받은 JSON 파일을 keys/ 폴더에 넣고 경로를 적습니다. (keys/ 폴더는 git에 올라가지 않습니다)
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json

# [선택] /feedback 에서 유튜브 조회수를 자동으로 갱신하려면 YouTube Data API v3 키를 넣습니다.
# 영상 가져오기(/ingest)에는 필요 없습니다. 비워 두면 조회수를 직접 알려 주면 됩니다.
YOUTUBE_API_KEY=

# 내 유튜브 채널 주소·사이트 주소 같은 공개 정보는 여기가 아니라 brand.md 에 적습니다.
